[
  {
    "name": "dicom-networking/locations-list",
    "path": "/admin/",
    "app": "admin",
    "steps": [
      {
        "click": "a:has-text('Locations')"
      },
      {
        "sleep": 4000
      }
    ],
    "callouts": [
      {
        "selector": "button:has-text('Create Location')",
        "label": "1"
      },
      {
        "selector": "button:has-text('Install Instructions')",
        "label": "2"
      },
      {
        "selector": "table >> nth=0",
        "label": "3"
      }
    ]
  },
  {
    "name": "dicom-networking/location-create",
    "path": "/admin/",
    "app": "admin",
    "steps": [
      {
        "click": "a:has-text('Locations')"
      },
      {
        "sleep": 3000
      },
      {
        "click": "button:has-text('Create Location')"
      },
      {
        "sleep": 1500
      }
    ],
    "clip": "css=[role=dialog]",
    "callouts": [
      {
        "selector": "input[value='11112']",
        "label": "1"
      },
      {
        "selector": "input[value='2762']",
        "label": "2"
      },
      {
        "selector": "text=Require client certificates",
        "label": "3"
      },
      {
        "selector": "text=DICOM DIMSE services uses S3 direct",
        "label": "4"
      }
    ]
  },
  {
    "name": "dicom-networking/location-network-access",
    "path": "/admin/",
    "app": "admin",
    "steps": [
      {
        "click": "a:has-text('Locations')"
      },
      {
        "sleep": 3000
      },
      {
        "click": "table tbody tr >> nth=0 >> input[type=radio]"
      },
      {
        "sleep": 500
      },
      {
        "click": "button:has-text('Edit')"
      },
      {
        "sleep": 1500
      },
      {
        "click": "text=Service Configuration"
      },
      {
        "sleep": 1200
      }
    ],
    "clip": "css=[role=dialog]",
    "callouts": [
      {
        "selector": "text=Allowed IP Addresses",
        "label": "1"
      },
      {
        "selector": "input[placeholder*='192.168']",
        "label": "2"
      },
      {
        "selector": "button:has-text('Add')",
        "label": "3"
      }
    ]
  },
  {
    "name": "dicom-networking/install-instructions",
    "path": "/admin/",
    "app": "admin",
    "steps": [
      {
        "click": "a:has-text('Locations')"
      },
      {
        "sleep": 3000
      },
      {
        "click": "button:has-text('Install Instructions')"
      },
      {
        "sleep": 1500
      }
    ],
    "clip": "css=[role=dialog]",
    "callouts": [
      {
        "selector": "pre",
        "label": "1"
      },
      {
        "selector": "button:has-text('Copy All Commands')",
        "label": "2"
      }
    ]
  },
