  {
    "name": "analytics/export-actions",
    "path": "/admin/",
    "app": "admin",
    "steps": [
      {
        "click": "a:has-text('Analytics')"
      },
      {
        "sleep": 3000
      },
      {
        "click": "text=Select one or more storages or virtual folders"
