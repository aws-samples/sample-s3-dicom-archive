        "sleep": 1000
      },
      {
        "fill": ".sql-editor-textarea",
        "value": "SELECT st.datastore_id, se.modality, se.seriesinstanceuid AS series_instance_uid, se.seriesdescription FROM series se JOIN study st ON se.study_pkey = st.study_pkey WHERE se.modality = 'CT'"
      },
      {
        "click": "button:has-text('Run Query')"
      },
      {
        "wait": "text=Completed"
      },
      {
        "sleep": 1500
      }
