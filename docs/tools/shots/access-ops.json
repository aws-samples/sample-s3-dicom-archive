[
  {
    "name": "users-and-access/users-list",
    "path": "/admin/",
    "app": "admin",
    "steps": [
      {
        "click": "a:has-text('Users')"
      },
      {
        "sleep": 4000
      },
      {
        "wait": "text=Create User"
      }
