# HL7 Server Configuration Example
# Copy this file to .env and modify values as needed

# Required Configuration
BUCKETNAME=my-hl7-archive-bucket
AWS_IOT_THING_NAME=hl7-dev-001

# HL7 Server Settings
HL7_PORT=2575
LOGLEVEL=INFO
THREADCOUNT=1

# Message Processing
MESSAGE_TIMEOUT=30
MAX_MESSAGE_SIZE=1048576
TLS_ENABLED=true

# MSH Validation (comma-separated lists)
SENDING_FACILITIES=HOSPITAL_A,CLINIC_B,LAB_C
SENDING_APPLICATIONS=EMR_SYSTEM,LAB_SYSTEM,RADIOLOGY_SYSTEM
RECEIVING_FACILITY=HL7_ARCHIVE
RECEIVING_APPLICATION=HL7_SERVER

# AWS Configuration
# Credentials come from the IAM role (ECS task role / Greengrass token exchange
# role) via the default boto3 credential chain. Do NOT put long-lived access
# keys in this file. Static keys are ignored unless HL7_ALLOW_STATIC_CREDENTIALS
# is explicitly set to true, which is intended only for isolated local testing
# with short-lived, least-privilege credentials.
REGION_NAME=us-east-1

# AWS Configuration (Greengrass Mode)
# AWS_REGION=us-east-1

# Storage Settings
S3_TRANSFER_ACCELERATION=false
STORAGE_THROTTLE=1000
STORAGE_OOR=100
